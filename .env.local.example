# Supabase Configuration
# Obtenha estas informações no painel do Supabase: https://app.supabase.com/
# 1. Acesse seu projeto no Supabase
# 2. Vá em Settings > API
# 3. Copie a URL e a chave anônima (anon/public)

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Chave pública/anônima do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Chave de serviço do Supabase (opcional, apenas para operações administrativas)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# URL de redirecionamento para autenticação (opcional)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000