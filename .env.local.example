# Supabase Configuration
# Obtenha estas informações no painel do Supabase: https://app.supabase.com/
# 1. Acesse seu projeto no Supabase
# 2. Vá em Settings > API
# 3. Copie a URL e a chave anônima (anon/public)

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Chave pública/anônima do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Chave de serviço do Supabase (opcional, apenas para scripts admin do servidor)
# NUNCA exponha em ambiente client-side: não use o prefixo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Sentry (opcional). Se não definido, a observability degrada para console.* em
# dev e no-op em produção. Para ativar:
#   npm install @sentry/nextjs
#   defina NEXT_PUBLIC_SENTRY_DSN abaixo
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# URL de redirecionamento para autenticação (opcional)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000